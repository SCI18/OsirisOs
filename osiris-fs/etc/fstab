# /etc/fstab - Osiris OS Filesystem Table
# Generated by Systems Spec for mountd monitoring
# Format: <device> <mount_point> <fs_type> <options> <dump> <pass>
# Osiris-specific options: x-osiris-alert-<type>=<value>

# Boot partition (EFI on x86, raw on ARM)
PARTUUID=<BOOT_PARTUUID>  /boot           vfat    defaults,noatime,x-osiris-alert=critical,x-osiris-alert-missing=1  0  2

# Root filesystem (Osiris packages)
PARTUUID=<ROOT_PARTUUID>  /osiris         ext4    defaults,noatime,ro,x-osiris-alert=critical,x-osiris-alert-missing=1,x-osiris-alert-fsmismatch=1  0  1

# Variable state (logs, entropy, package DB)
PARTUUID=<VAR_PARTUUID>   /osiris/var     ext4    defaults,noatime,x-osiris-alert=critical,x-osiris-alert-missing=1,x-osiris-disk-warning=85,x-osiris-disk-critical=95  0  2

# User home directories
PARTUUID=<HOME_PARTUUID>  /osiris/home    ext4    defaults,noatime,nodev,nosuid,x-osiris-alert=warning,x-osiris-disk-warning=80,x-osiris-disk-critical=90  0  2

# Optional packages
PARTUUID=<OPT_PARTUUID>   /osiris/opt     ext4    defaults,noatime,nodev,x-osiris-alert=info,x-osiris-disk-warning=90  0  2

# Virtual filesystems (mounted by Kha before Bridge spawn)
proc      /proc       proc    defaults,nosuid,noexec,nodev  0  0
sysfs     /sys        sysfs   defaults,nosuid,noexec,nodev  0  0
devtmpfs  /dev        devtmpfs defaults,mode=0755,nosuid   0  0
tmpfs     /run        tmpfs   defaults,mode=0755,nosuid,nodev,size=10%  0  0
tmpfs     /osiris/run tmpfs   defaults,mode=0755,nosuid,nodev,size=10%  0  0

# Security: restrict access to kernel interfaces
securityfs /sys/kernel/security securityfs defaults,nosuid,noexec,nodev  0  0